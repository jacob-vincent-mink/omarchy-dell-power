#!/bin/bash
# dell-charge-limit — privileged charge/power controller for the
# Omarchy widget io.github.nipsen.dell-power.
#
# All operations are validated against hardcoded allowlists. This script
# never touches anything but:
#   /sys/class/power_supply/BAT0/charge_control_{start,end}_threshold
#   /sys/class/firmware-attributes/dell-wmi-sysman/attributes/<attr>/current_value
#   /run/dell-power/state  (world-readable cache, refreshed as root)
# Read-only operations additionally read:
#   /sys/class/powercap/intel-rapl*/{name,energy_uj}   (root-only energy counters)
#   /sys/class/power_supply/{BAT0,AC,ucsi-source-psy-*}/…
#
# Usage :
#   dell-charge-limit status
#   dell-charge-limit power-chain
#   dell-charge-limit set-start N
#   dell-charge-limit set-end N
#   dell-charge-limit wmi <attribut> <valeur>
# Anything else is refused.

set -u

BAT=/sys/class/power_supply/BAT0
WMI=/sys/class/firmware-attributes/dell-wmi-sysman/attributes
STATE_DIR=/run/dell-power
STATE=$STATE_DIR/state

START_MIN=50
START_MAX=95
END_MIN=55
END_MAX=100
GAP=5

declare -A WMI_ALLOWED=(
  [PrimaryBattChargeCfg]="Standard Express Adaptive PrimAcUse Custom"
  [LongLifeCyclePriBattery]="Enabled Disabled"
  [UsbPowerShare]="Enabled Disabled"
  [TypeCPower]="7.5W 15W"
  [PeakShiftCfg]="Enabled Disabled"
  [AdvBatteryChargeCfg]="Enabled Disabled"
)

fail() {
  # L'erreur JSON part sur stdout (pour que le widget la parse et l'affiche)
  # ET sur stderr (pour un usage terminal).
  local m
  m=$(jq -n --arg m "$1" '$m')
  printf '%s\n' "$m"
  printf '%s\n' "$m" >&2
  exit 1
}

is_root() { [[ $(id -u) == 0 ]]; }

wmi_read() {
  cat "$WMI/$1/current_value" 2>/dev/null || true
}

wmi_write() {
  printf '%s' "$2" > "$WMI/$1/current_value" 2>/dev/null
}

read_threshold() {
  cat "$BAT/charge_control_$1_threshold" 2>/dev/null || true
}

read_ec_json() {
  local s e
  s=$(read_threshold start)
  e=$(read_threshold end)
  jq -n --arg s "$s" --arg e "$e" \
    '{start:(if $s == "" then null else ($s|tonumber) end),
      end:(if $e == "" then null else ($e|tonumber) end)}'
}

read_wmi_json() {
  jq -n \
    --arg m "$(wmi_read PrimaryBattChargeCfg)" \
    --arg l "$(wmi_read LongLifeCyclePriBattery)" \
    --arg u "$(wmi_read UsbPowerShare)" \
    --arg t "$(wmi_read TypeCPower)" \
    --arg p "$(wmi_read PeakShiftCfg)" \
    --arg a "$(wmi_read AdvBatteryChargeCfg)" \
    '{mode:(if $m == "" then null else $m end),
      llc:(if $l == "" then null else $l end),
      usbPowerShare:(if $u == "" then null else $u end),
      typeCPower:(if $t == "" then null else $t end),
      peakShift:(if $p == "" then null else $p end),
      advBatteryCharge:(if $a == "" then null else $a end)}'
}

write_cache() { # $1 = json WMI
  local tmp=$STATE.tmp
  if mkdir -p "$STATE_DIR" && \
     jq -n --argjson w "$1" --argjson t "$(read_ec_json)" --arg ts "$(date +%s)" \
       '{thresholds:$t, wmi:$w, updatedAt:$ts}' > "$tmp" 2>/dev/null; then
    mv "$tmp" "$STATE"
  fi
}

load_cache() { cat "$STATE" 2>/dev/null || printf '{}'; }

cmd_status() {
  local ec wmi src dell=false
  [[ -d $WMI ]] && dell=true
  ec=$(read_ec_json)
  if is_root; then
    wmi=$(read_wmi_json)
    # At boot, the dell-wmi-sysman interface appears progressively:
    # retry briefly until the charge mode is readable.
    local attempt=0
    while (( attempt < 10 )) && $dell && [[ -z $(printf '%s' "$wmi" | jq -r '.mode // empty') ]]; do
      sleep 1
      wmi=$(read_wmi_json)
      attempt=$(( attempt + 1 ))
    done
    write_cache "$wmi" 2>/dev/null || true
    src=live
  else
    wmi=$(load_cache | jq -c '.wmi // {}')
    src=cache
  fi
  jq -n --argjson t "$ec" --argjson w "$wmi" --arg s "$src" --argjson d "$dell" \
    '{ok:true, dell:$d, source:$s, thresholds:$t, wmi:$w}'
}

cmd_set() {
  local which=$1
  local value=${2:-}
  [[ $value =~ ^[0-9]+$ ]] || fail "invalid value: $value"

  local start end
  start=$(read_threshold start)
  end=$(read_threshold end)
  [[ -n $start && -n $end ]] || fail "no battery"

  local nstart nend
  if [[ $which == start ]]; then
    (( value >= START_MIN && value <= START_MAX )) || fail "start out of range ($START_MIN-$START_MAX)"
    nstart=$value
    nend=$end
    if (( nend < nstart + GAP )); then nend=$(( nstart + GAP )); fi
    (( nend <= END_MAX )) || fail "impossible: end would exceed $END_MAX"
  else
    (( value >= END_MIN && value <= END_MAX )) || fail "end out of range ($END_MIN-$END_MAX)"
    nend=$value
    nstart=$start
    if (( nstart > nend - GAP )); then nstart=$(( nend - GAP )); fi
    (( nstart >= START_MIN )) || fail "impossible: start would go below $START_MIN"
  fi

  # Les seuils ne s'appliquent qu'en mode Custom.
  wmi_write PrimaryBattChargeCfg Custom
  [[ $(wmi_read PrimaryBattChargeCfg) == Custom ]] || fail "unable to switch to Custom mode"

  printf '%d' "$nstart" > "$BAT/charge_control_start_threshold" 2>/dev/null \
    || fail "start write refused"
  printf '%d' "$nend" > "$BAT/charge_control_end_threshold" 2>/dev/null \
    || fail "end write refused"

  local rs re
  rs=$(read_threshold start)
  re=$(read_threshold end)
  if [[ $rs != $nstart || $re != $nend ]]; then
    fail "the firmware adjusted the values ($rs/$re instead of $nstart/$nend)"
  fi

  local wmi
  wmi=$(read_wmi_json)
  write_cache "$wmi" 2>/dev/null || true
  jq -n --argjson t "$(read_ec_json)" --argjson w "$wmi" \
    '{ok:true, dell:true, source:"live", thresholds:$t, wmi:$w}'
}

cmd_wmi() {
  local attr=${1:-} value=${2:-}
  [[ -n $attr ]] || fail "attribute required"
  [[ -v WMI_ALLOWED[$attr] ]] || fail "unknown attribute: $attr"

  local allowed=${WMI_ALLOWED[$attr]} found=""
  local v
  for v in $allowed; do [[ $v == "$value" ]] && found=1; done
  [[ -n $found ]] || fail "value not allowed for $attr: $value"

  wmi_write "$attr" "$value" || fail "write refused by the firmware"

  local rb wmi
  rb=$(wmi_read "$attr")
  wmi=$(read_wmi_json)
  write_cache "$wmi" 2>/dev/null || true
  if [[ $rb == "$value" ]]; then
    jq -n --argjson w "$wmi" '{ok:true, dell:true, applied:true, wmi:$w}'
  else
    jq -n --argjson w "$wmi" --arg rb "$rb" \
      '{ok:true, dell:true, applied:false, readback:$rb, wmi:$w}'
  fi
}

# power-chain — Dell power-flow chain reader. Read-only; needs root for the
# RAPL energy counters (the whole point: they stay root-only, no world-readable
# udev rule). Returns only 1-second aggregate watts, never raw counters.
#
# Sortie JSON :
#   { "source": "mains"|"typec"|"battery", "usbType": "PD"|"" ...,
#     "systemW": platform total (RAPL psys), "batteryW": +in/-out,
#     "componentsW": platform minus battery, "cpuW"/"ramW"/"igpuW": RAPL,
#     "screenW": deduced residual, "packV"/"packA": pack voltage/current }
cmd_power_chain() {
  local RAPL=/sys/class/powercap
  local UCSI='/sys/class/power_supply/ucsi-source-psy-*'

  rapl_energy() { # $1 = nom de domaine (psys, package-0, dram)
    local d
    for d in "$RAPL"/intel-rapl*; do
      if [[ -f $d/name && $(cat "$d/name" 2>/dev/null) == "$1" ]]; then
        cat "$d/energy_uj" 2>/dev/null
        return
      fi
    done
  }

  local e_psys e_pkg e_dram e_core e_uncore f_psys f_pkg f_dram f_core f_uncore
  local v1 i1 v2 i2
  e_psys=$(rapl_energy psys) || e_psys=""
  e_pkg=$(rapl_energy package-0) || e_pkg=""
  e_dram=$(rapl_energy dram) || e_dram=""
  e_core=$(rapl_energy core) || e_core=""
  e_uncore=$(rapl_energy uncore) || e_uncore=""
  v1=$(cat "$BAT/voltage_now" 2>/dev/null) || v1=""
  i1=$(cat "$BAT/current_now" 2>/dev/null) || i1=""
  sleep 1
  f_psys=$(rapl_energy psys) || f_psys=""
  f_pkg=$(rapl_energy package-0) || f_pkg=""
  f_dram=$(rapl_energy dram) || f_dram=""
  f_core=$(rapl_energy core) || f_core=""
  f_uncore=$(rapl_energy uncore) || f_uncore=""
  v2=$(cat "$BAT/voltage_now" 2>/dev/null) || v2=""
  i2=$(cat "$BAT/current_now" 2>/dev/null) || i2=""
  # -- end of sampling --

  watts() { # $1 e1 $2 e2 -> W (µJ sur 1 s = µW)
    awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", (b - a) / 1e6 }'
  }

  local systemW=null cpuW=null ramW=null coreW=null uncoreW=null igpuW=null
  [[ -n $e_psys && -n $f_psys ]] && systemW=$(watts "$e_psys" "$f_psys")
  [[ -n $e_pkg && -n $f_pkg ]] && cpuW=$(watts "$e_pkg" "$f_pkg")
  [[ -n $e_dram && -n $f_dram ]] && ramW=$(watts "$e_dram" "$f_dram")
  [[ -n $e_core && -n $f_core ]] && coreW=$(watts "$e_core" "$f_core")
  [[ -n $e_uncore && -n $f_uncore ]] && uncoreW=$(watts "$e_uncore" "$f_uncore")
  if [[ $cpuW != null && $coreW != null && $uncoreW != null ]]; then
    igpuW=$(awk -v p="$cpuW" -v c="$coreW" -v u="$uncoreW" \
      'BEGIN { g = p - c - u; if (g < 0) g = 0; printf "%.1f", g }')
  fi

  # Battery power averaged over the sampling window (V×I at both ends) so it
  # stays consistent with the RAPL deltas (1 s averages).
  local batteryW=null
  if [[ -n $v1 && -n $i1 && -n $v2 && -n $i2 ]]; then
    batteryW=$(awk -v v1="$v1" -v i1="$i1" -v v2="$v2" -v i2="$i2" \
      'BEGIN { printf "%.1f", (v1 * i1 + v2 * i2) / 2e12 }')
  fi

  # Pack voltage (V) and current (A), same averaging window. The EC reports
  # unsigned current; the sign is applied from the battery state further down.
  local packV=null packA=null
  if [[ -n $v1 && -n $v2 ]]; then
    packV=$(awk -v v1="$v1" -v v2="$v2" 'BEGIN { printf "%.2f", (v1 + v2) / 2e6 }')
  fi
  if [[ -n $i1 && -n $i2 ]]; then
    packA=$(awk -v i1="$i1" -v i2="$i2" 'BEGIN { printf "%.2f", (i1 + i2) / 2e6 }')
  fi

  # Design capacity when new (Wh): charge_full_design (µAh) × nominal voltage.
  local nominalWh=null cfd vmin
  cfd=$(cat "$BAT/charge_full_design" 2>/dev/null) || cfd=""
  vmin=$(cat "$BAT/voltage_min_design" 2>/dev/null) || vmin=""
  if [[ -n $cfd && -n $vmin ]]; then
    nominalWh=$(awk -v c="$cfd" -v v="$vmin" 'BEGIN { printf "%.0f", c * v / 1e12 }')
  fi

  local ac uc=0 f
  ac=$(cat /sys/class/power_supply/AC/online 2>/dev/null) || ac=0
  for f in $UCSI; do
    [[ -d $f ]] || continue
    if [[ $(cat "$f/online" 2>/dev/null) == 1 ]]; then uc=1; break; fi
  done

  # USB-C port: power delivered to a connected device (phone, etc.).
  # Le pilote ucsi peut rapporter une tension nulle : on suppose alors 5 V.
  local portW=null uv ui
  for f in $UCSI; do
    [[ -d $f ]] || continue
    uv=$(cat "$f/voltage_now" 2>/dev/null) || uv=""
    ui=$(cat "$f/current_now" 2>/dev/null) || ui=""
    if [[ -n $ui && $ui -gt 0 ]]; then
      [[ -z $uv || $uv -eq 0 ]] && uv=5000000
      portW=$(awk -v v="$uv" -v i="$ui" 'BEGIN { printf "%.1f", v * i / 1e12 }')
      break
    fi
  done

  local usbType=""
  if [[ $uc == 1 ]]; then
    for f in $UCSI; do
      [[ -f $f/usb_type ]] || continue
      usbType=$(tr -d '[]' < "$f/usb_type" | awk '{print $1}')
      break
    done
  fi

  local source
  if [[ $ac == 1 ]]; then source="mains"
  elif [[ $uc == 1 ]]; then source="typec"
  else source="battery"
  fi

  # The EC may report positive current even while discharging. Trust the
  # battery STATE (not the source presence) for the sign: a weak USB-C adapter
  # can leave the battery powering the laptop even while "plugged in".
  local bstat discharging=false
  bstat=$(cat "$BAT/status" 2>/dev/null) || bstat=""
  [[ $bstat == "Discharging" ]] && discharging=true

  if $discharging && [[ $batteryW != null ]]; then
    batteryW=$(awk -v w="$batteryW" 'BEGIN { if (w > 0) w = -w; printf "%.1f", w }')
  fi
  if $discharging && [[ $packA != null ]]; then
    packA=$(awk -v a="$packA" 'BEGIN { if (a > 0) a = -a; printf "%.2f", a }')
  fi

  local componentsW=null adapterW=null
  if [[ $batteryW != null ]]; then
    if $discharging; then
      # The battery is supplying. psys measures the platform draw, so the
      # adapter's contribution is whatever the battery doesn't cover.
      if [[ $systemW != null ]]; then
        componentsW=$systemW
        adapterW=$(awk -v s="$systemW" -v b="$batteryW" \
          'BEGIN { a = s + b; if (a < 0) a = 0; printf "%.1f", a }')
      else
        componentsW=$(awk -v b="$batteryW" 'BEGIN { c = -b; if (c < 0) c = 0; printf "%.1f", c }')
      fi
    elif [[ $source == "battery" ]]; then
      # On battery (not discharging per state, e.g. idle): same fallback.
      componentsW=$(awk -v b="$batteryW" 'BEGIN { c = -b; if (c < 0) c = 0; printf "%.1f", c }')
    elif [[ $systemW != null ]]; then
      # On AC, psys measures the platform ALONE (charging is not counted —
      # verified empirically). The adapter provides both.
      componentsW=$systemW
      adapterW=$(awk -v s="$systemW" -v b="$batteryW" \
        'BEGIN { c = s + (b > 0 ? b : 0); printf "%.1f", c }')
    fi
  fi

  local screenW=null
  if [[ $componentsW != null && $cpuW != null && $ramW != null ]]; then
    screenW=$(awk -v c="$componentsW" -v p="$cpuW" -v r="$ramW" \
      'BEGIN { s = c - p - r; if (s < 0) s = 0; printf "%.1f", s }')
  fi

  jq -n --arg s "$source" --arg t "$usbType" \
    --argjson b "$batteryW" --argjson y "$systemW" --argjson c "$componentsW" \
    --argjson a "$adapterW" \
    --argjson p "$cpuW" --argjson r "$ramW" --argjson e "$screenW" \
    --argjson g "$igpuW" --argjson n "$nominalWh" --argjson w "$portW" \
    --argjson pv "$packV" --argjson pa "$packA" \
    '{source:$s, usbType:$t, batteryW:$b, systemW:$y, adapterW:$a, componentsW:$c, cpuW:$p, ramW:$r, screenW:$e, igpuW:$g, nominalWh:$n, portW:$w, packV:$pv, packA:$pa}'
}

cmd=${1:-}
case "$cmd" in
  status) cmd_status ;;
  power-chain) cmd_power_chain ;;
  set-start) cmd_set start "${2:-}" ;;
  set-end) cmd_set end "${2:-}" ;;
  wmi) cmd_wmi "${@:2}" ;;
  *) fail "unknown command: ${cmd:-}" ;;
esac
