#!/bin/bash
# Read the scoped NPU Waveform reader's energy-derived watts, when available.
set -u

present=false
for device in /sys/class/accel/accel*; do
  [[ -f $device/device/npu_busy_time_us ]] || continue
  [[ $(cat "$device/device/vendor" 2>/dev/null) == 0x8086 ]] || continue
  [[ $(readlink -f "$device/device/driver" 2>/dev/null) == /sys/bus/pci/drivers/intel_vpu ]] || continue
  present=true
  break
done

watts=null
if $present && [[ -r /run/npu-waveform/npu-energy ]]; then
  IFS='|' read -r sample_time energy range sample_watts < /run/npu-waveform/npu-energy
  read -r now rest < /proc/uptime
  if [[ $sample_time =~ ^[0-9]+([.][0-9]+)?$ && $sample_watts =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    watts=$(awk -v now="$now" -v then="$sample_time" -v value="$sample_watts" \
      'BEGIN { age = now - then; if (age >= -0.1 && age <= 3) printf "%.3f", value; else print "null" }')
  fi
fi
printf '{"present":%s,"watts":%s}\n' "$present" "$watts"
