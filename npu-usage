#!/bin/bash
# Read Intel NPU activity without privilege. The package RAPL counter already
# accounts for NPU energy; intel_vpu exposes busy time for its separate row.
set -u

busy_file=""
for device in /sys/class/accel/accel*; do
  [[ -f $device/device/npu_busy_time_us ]] || continue
  [[ $(cat "$device/device/vendor" 2>/dev/null) == 0x8086 ]] || continue
  [[ $(readlink -f "$device/device/driver" 2>/dev/null) == /sys/bus/pci/drivers/intel_vpu ]] || continue
  busy_file=$device/device/npu_busy_time_us
  break
done

if [[ -z $busy_file ]]; then
  printf '{"present":false,"util":null}\n'
  exit 0
fi

before=$(cat "$busy_file" 2>/dev/null) || before=""
start=$(date +%s%N)
sleep 1
after=$(cat "$busy_file" 2>/dev/null) || after=""
end=$(date +%s%N)

util=null
if [[ $before =~ ^[0-9]+$ && $after =~ ^[0-9]+$ ]]; then
  util=$(awk -v a="$before" -v b="$after" -v start="$start" -v end="$end" \
    'BEGIN { elapsed = (end - start) / 1000; if (elapsed <= 0 || b < a) { print "null"; exit } \
      pct = (b - a) * 100 / elapsed; if (pct > 100) pct = 100; printf "%.0f", pct }')
fi
printf '{"present":true,"util":%s}\n' "$util"
